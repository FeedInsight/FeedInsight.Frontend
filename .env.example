# Base URL of FeedInsight.WebApi (Presentation layer). No trailing slash.
VITE_API_BASE_URL=https://localhost:7001/api

# Default X-Tenant-Id used only in local development when the customer portal
# is not resolving a tenant from a subdomain/public key. Never rely on this
# in production -- production tenant resolution happens in TenantResolver.
VITE_DEV_TENANT_ID=00000000-0000-0000-0000-000000000000

# Toggles mock API mode (MSW-style) for frontend-only development before the
# backend endpoints listed in shared/api/endpoints.js exist. "true" | "false".
VITE_USE_MOCKS=false
