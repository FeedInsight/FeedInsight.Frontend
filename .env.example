# Base URL of the FeedInsight .NET Web API (FeedInsight.WebApi)
REACT_APP_API_BASE_URL=https://localhost:5001/api

# Public key used by the Customer Portal to resolve tenant context.
# The API middleware maps this to a Tenant record and sets X-Tenant-Id internally,
# OR you send X-Tenant-Id directly if you resolve it client-side via subdomain.
REACT_APP_DEFAULT_TENANT_PUBLIC_KEY=

# Feature flags
REACT_APP_ENABLE_CHAT_STREAMING=true
REACT_APP_ENABLE_SCREENSHOT_UPLOAD=true

# Optional: Sentry / analytics DSN, etc.
REACT_APP_SENTRY_DSN=
