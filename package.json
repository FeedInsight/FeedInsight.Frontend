    "format": "prettier --write \"src/**/*.{js,jsx,css}\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "react-scripts": "5.0.1",
    "axios": "^1.7.4",
    "@reduxjs/toolkit": "^2.2.7",
    "react-redux": "^9.1.2",
    "recharts": "^2.12.7",
    "react-hook-form": "^7.52.2",
    "date-fns": "^3.6.0",
    "clsx": "^2.1.1",
    "jwt-decode": "^4.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
